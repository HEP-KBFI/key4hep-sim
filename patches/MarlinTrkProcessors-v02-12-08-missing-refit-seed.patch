+namespace {
+bool hasUsableFit(const EVENT::Track& track) {
+  if (track.getNdf() <= 0 || !std::isfinite(track.getChi2()) || track.getChi2() < 0)
+    return false;
+
+  const auto& states = track.getTrackStates();
+  for (const int location : {TrackState::AtIP, TrackState::AtFirstHit, TrackState::AtLastHit}) {
+    if (std::count_if(states.begin(), states.end(),
+                      [location](const auto* state) { return state->getLocation() == location; }) != 1)
+      return false;
+  }
+
+  const auto* ip = track.getTrackState(TrackState::AtIP);
+  const auto* firstHitPosition = track.getTrackState(TrackState::AtFirstHit)->getReferencePoint();
+  return std::isfinite(ip->getD0()) && std::isfinite(ip->getPhi()) && std::isfinite(ip->getOmega()) &&
+         ip->getOmega() != 0 && std::isfinite(ip->getZ0()) && std::isfinite(ip->getTanLambda()) &&
+         std::isfinite(firstHitPosition[0]) && std::isfinite(firstHitPosition[1]);
+}
+} // namespace
